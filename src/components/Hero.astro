---
const slides = [
  {
    image: '/portfolio/luck00.jpg',
    project: 'Luck',
    studio: 'Skydance Animation',
  },
  {
    image: '/portfolio/angry00.png',
    project: 'Angry Birds Journey',
    studio: 'Able&Baker',
  },
  {
    image: '/portfolio/audi00.png',
    project: 'Audi — A Shorter Letter',
    studio: 'The Frank Barton Company',
  },
  {
    image: '/portfolio/sky.jpg',
    project: 'Sky Rojo',
    studio: 'DØ Postproduction',
  },
{
    image: '/portfolio/superthings.png',
    project: 'SuperThings',
    studio: 'Keytoon',
  },


];
---

<section class="hero" id="hero">

  <!-- CARRUSEL DE FONDO -->
  <div class="carousel" id="carousel" aria-hidden="true">
    {slides.map((slide, i) => (
      <div class={`slide ${i === 0 ? 'active' : ''}`} data-project={slide.project} data-studio={slide.studio} style={`background-image: url('${slide.image}')`}></div>
    ))}
    <video id="hero-video" class="hero-video" muted loop playsinline preload="none" poster="/video/selected-work-v2.jpg" data-src="/video/selected-work-v2.mp4" tabindex="-1"></video>
    <!-- Overlay oscuro encima de las imágenes para que el texto sea legible -->
    <div class="carousel-overlay"></div>
  </div>

  <!-- FLECHAS DE NAVEGACIÓN -->
  <button class="arrow arrow-prev" id="prev" aria-label="Anterior">&#8249;</button>
  <button class="arrow arrow-next" id="next" aria-label="Siguiente">&#8250;</button>

  <!-- INDICADOR DE SLIDE (nombre del proyecto) -->
  <div class="slide-info" id="slide-info">
    <span class="slide-project" id="slide-project">{slides[0].project}</span>
    <span class="slide-sep">/</span>
    <span class="slide-studio" id="slide-studio">{slides[0].studio}</span>
    <span class="video-credit" id="video-credit"></span>
  </div>

  <!-- DOTS -->
  <div class="dots" id="dots">
    {slides.map((_, i) => (
      <button class={`dot ${i === 0 ? 'active' : ''}`} data-index={i} aria-pressed={i === 0} aria-label={`Slide ${i + 1}`}></button>
    ))}
  </div>

  <button class="carousel-toggle" id="carousel-toggle" aria-pressed="false">Pause slideshow</button>

  <!-- CONTENIDO PRINCIPAL (encima del carrusel) -->
  <div class="hero-content">
    <div class="eyebrow">Environment/ Sets and Props Modeler</div>
    <h1 class="hero-name">
      <span class="line">JUAN</span>
      <span class="line accent">MANCHADO</span>
    </h1>
    <div class="hero-role">Sets &amp; Props Modeler</div>
    <p class="hero-tagline">
      7+ years creating production-ready assets and environments<br>
      for international feature films and animated series.
    </p>
    <div class="platforms">
      <span>NETFLIX</span>
      <span class="dot-sep">·</span>
      <span>APPLE TV+</span>
      <span class="dot-sep">·</span>
      <span>PRIME VIDEO</span>
    </div>
    <div class="hero-cta">
      <a href="#shows" class="btn-outline">VIEW WORK</a>
      <a href="#about" class="btn-ghost">ABOUT ME</a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-hint">
    <div class="scroll-line"></div>
    <span>SCROLL</span>
  </div>

</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  /* ---- CARRUSEL ---- */
  .carousel {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .5s; }
  .hero.video-active .hero-video { opacity: 1; }
  .hero.video-active { min-height: 860px; padding-bottom: 110px; }
  .hero.video-active .arrow, .hero.video-active .dots { display: none; }
  .video-credit { display: none; font-size: .65rem; color: #ddd; letter-spacing: 1px; }
  .hero.video-active .slide-info { flex-wrap: wrap; justify-content: center; width: min(650px, calc(100% - 3rem)); }
  .hero.video-active .video-credit { display: block; flex-basis: 100%; }
  @media (prefers-reduced-motion: reduce) { .slide, .hero-video { transition: none; transform: none; } .hero-content, .scroll-line { animation: none; } }

  .slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 1.2s ease;
    /* Zoom suave como Ken Burns */
    transform: scale(1.08);
    transition: opacity 1.2s ease, transform 8s ease;
  }
  .slide.active {
    opacity: 1;
    transform: scale(1);
  }

  /* Overlay degradado oscuro — igual que Albert Valls */
  .carousel-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom,
        rgba(10,10,10,0.55) 0%,
        rgba(10,10,10,0.35) 40%,
        rgba(10,10,10,0.55) 70%,
        rgba(10,10,10,0.92) 100%
      );
    z-index: 1;
  }

  /* ---- FLECHAS ---- */
  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.4);
    font-size: 3.5rem;
    cursor: pointer;
    padding: 1rem;
    line-height: 1;
    transition: color 0.2s;
    font-weight: 300;
  }
  .arrow:hover { color: var(--gold); }
  .arrow-prev { left: 1.5rem; }
  .arrow-next { right: 1.5rem; }

  /* ---- INFO DEL SLIDE (abajo, estilo Albert Valls) ---- */
  .slide-info {
    position: absolute;
    bottom: 5.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    transition: opacity 0.4s;
  }
  .slide-project {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--text);
  }
  /* Línea dorada bajo el título, como Albert Valls */
  .slide-project::after {
    content: '';
    display: block;
    width: 100%;
    height: 1px;
    background: var(--gold);
    margin-top: 3px;
  }
  .slide-sep {
    color: var(--muted-2);
    font-size: 0.75rem;
    padding-bottom: 2px;
  }
  .slide-studio {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
  }

  /* ---- DOTS ---- */
  .dots {
    position: absolute;
    bottom: 3.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    gap: 0.6rem;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255,255,255,0.25);
    border: none;
    cursor: pointer;
    transition: background 0.3s, transform 0.3s;
    padding: 0;
  }
  .dot.active {
    background: var(--gold);
    transform: scale(1.4);
  }

  /* ---- CONTENIDO PRINCIPAL ---- */
  .hero-content {
    position: relative;
    z-index: 5;
    max-width: 900px;
    padding: 2rem;
    animation: fadeUp 1s ease both;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .eyebrow {
    font-size: 0.7rem;
    letter-spacing: 5px;
    font-weight: 700;
    color: var(--gold);
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  .hero-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(4rem, 12vw, 9rem);
    line-height: 0.9;
    letter-spacing: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 1.2rem;
  }
  .line {
    display: block;
    color: var(--text);
  }
  .line.accent {
    -webkit-text-stroke: 1.5px var(--gold);
    color: transparent;
  }

  .hero-role {
    font-size: 1rem;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #ffffff;
    font-weight: 700;
    margin-bottom: 1.5rem;
    text-shadow: 0 1px 8px rgba(0,0,0,0.9);
  }

  .hero-tagline {
    font-size: 0.95rem;
    color: rgba(255,255,255,0.88);
    font-weight: 400;
    max-width: 580px;
    margin: 0 auto 2.5rem;
    line-height: 1.8;
    text-shadow: 0 1px 10px rgba(0,0,0,0.95);

  }

  .platforms {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    font-size: 0.65rem;
    letter-spacing: 3px;
    font-weight: 700;
    color: rgba(255,255,255,0.65);
    text-transform: uppercase;
    margin-bottom: 3rem;
    text-shadow: 0 1px 6px rgba(0,0,0,0.8);
  }
  .dot-sep { color: var(--gold); font-size: 0.5rem; }

  .hero-cta {
    display: flex;
    gap: 1.2rem;
    justify-content: center;
  }

  .btn-outline {
    padding: 0.9rem 2.8rem;
    border: 1.5px solid var(--gold);
    color: var(--gold);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    transition: background 0.3s, color 0.3s;
    border-radius: 2px;
  }
  .btn-outline:hover { background: var(--gold); color: #000; }

  .btn-ghost {
    padding: 0.9rem 2.8rem;
    border: 1.5px solid var(--border);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    transition: border-color 0.3s, color 0.3s;
    border-radius: 2px;
  }
  .btn-ghost:hover { border-color: var(--muted); color: var(--text); }

  /* ---- SCROLL HINT ---- */
  .scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 2.5rem;          /* lo ponemos a la izquierda como Albert Valls */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    z-index: 10;
  }
  .scroll-hint span {
    font-size: 0.52rem;
    letter-spacing: 3px;
    color: var(--muted-2);
    font-weight: 700;
  }
  .scroll-line {
    width: 1px;
    height: 50px;
    background: linear-gradient(to bottom, var(--gold), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  .hero { min-height: 740px; }
  .carousel-toggle { position: absolute; right: 1.5rem; bottom: 1.5rem; z-index: 10; background: #101010aa; border: 1px solid #777; color: #ddd; padding: .6rem .8rem; font: inherit; font-size: .65rem; cursor: pointer; }
  .dot { width: 28px; height: 28px; background: radial-gradient(circle, #888 3px, transparent 4px); }
  .dot.active { background: radial-gradient(circle, var(--gold) 4px, transparent 5px); transform: none; }
  .dots { gap: .2rem; bottom: 2.8rem; }
  .slide-info { max-width: calc(100% - 3rem); text-align: center; }
  @media (max-width: 600px) {
    .hero.video-active { min-height: 740px; padding: 30px 0 170px; }
    .hero { height: auto; min-height: 690px; padding: 30px 0 150px; }
    .hero-content { padding: 1.5rem; width: 100%; }
    .hero-name { font-size: clamp(3.2rem, 15vw, 5.5rem); letter-spacing: 3px; }
    .eyebrow { font-size: .6rem; letter-spacing: 2px; }
    .hero-role { font-size: .8rem; letter-spacing: 2px; }
    .hero-tagline { font-size: .8rem; margin-bottom: 1.5rem; }
    .hero-tagline br { display: none; }
    .platforms { font-size: .55rem; letter-spacing: 1px; gap: .5rem; margin-bottom: 1.5rem; }
    .hero-cta { flex-wrap: wrap; gap: .6rem; }
    .btn-outline, .btn-ghost { padding: .85rem 1rem; font-size: .65rem; letter-spacing: 1px; }
    .arrow { top: auto; bottom: 65px; padding: .5rem; font-size: 2.5rem; transform: none; }
    .arrow-prev { left: .25rem; } .arrow-next { right: .25rem; }
    .slide-info { bottom: 90px; width: calc(100% - 5rem); flex-direction: column; gap: .25rem; }
    .slide-project, .slide-studio { font-size: .65rem; letter-spacing: 1px; }
    .slide-sep, .scroll-hint { display: none; }
    .dots { bottom: 48px; }
    .carousel-toggle { bottom: 8px; right: 50%; transform: translateX(50%); }
  }
</style>

<script>
  import credits from '../data/hero-montage.json';
  const slides = [...document.querySelectorAll<HTMLElement>('.slide')];
  const dots = [...document.querySelectorAll<HTMLElement>('.dot')];
  const hero = document.querySelector<HTMLElement>('.hero');
  const toggle = document.querySelector<HTMLButtonElement>('#carousel-toggle');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let current = 0;
  let paused = reducedMotion.matches;
  let timer: ReturnType<typeof setInterval> | undefined;
  const video = document.querySelector<HTMLVideoElement>('#hero-video');
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  let videoActive = false;
  let inView = true;
  let videoFailed = false;
  function updateCredit() {
    if (!video || !videoActive) return;
    const credit = credits.find(item => video.currentTime < item.until) ?? credits[credits.length - 1];
    document.getElementById('slide-project')!.textContent = credit.project;
    document.getElementById('slide-studio')!.textContent = credit.studio;
    document.getElementById('video-credit')!.textContent = credit.role;
  }
  function fallback() {
    videoFailed = true;
    videoActive = false;
    video?.pause();
    hero?.classList.remove('video-active');
    goTo(current);
    restart();
  }
  function goTo(index: number) {
    current = (index + slides.length) % slides.length;
    slides.forEach((slide, i) => slide.classList.toggle('active', i === current));
    dots.forEach((dot, i) => {
      dot.classList.toggle('active', i === current);
      dot.setAttribute('aria-pressed', String(i === current));
    });
    const project = document.getElementById('slide-project');
    const studio = document.getElementById('slide-studio');
    if (project) project.textContent = slides[current].dataset.project ?? '';
    if (studio) studio.textContent = slides[current].dataset.studio ?? '';
  }
  function restart() {
    clearInterval(timer);
    const canPlay = !paused && !document.hidden && inView;
    if (videoActive && video) {
      if (canPlay) video.play().catch(fallback);
      else video.pause();
    } else if (canPlay && !hero?.matches(':focus-within')) timer = setInterval(() => goTo(current + 1), 5000);
    if (toggle) {
      toggle.textContent = `${paused ? 'Play' : 'Pause'} ${videoActive ? 'video' : 'slideshow'}`;
      toggle.setAttribute('aria-pressed', String(paused));
    }
  }
  document.getElementById('next')?.addEventListener('click', () => { goTo(current + 1); restart(); });
  document.getElementById('prev')?.addEventListener('click', () => { goTo(current - 1); restart(); });
  dots.forEach((dot, index) => dot.addEventListener('click', () => { goTo(index); restart(); }));
  toggle?.addEventListener('click', () => { paused = !paused; restart(); });
  hero?.addEventListener('focusin', () => clearInterval(timer));
  hero?.addEventListener('focusout', () => requestAnimationFrame(restart));
  document.addEventListener('visibilitychange', restart);
  reducedMotion.addEventListener('change', event => { paused = event.matches; restart(); });
  video?.addEventListener('timeupdate', updateCredit);
  video?.addEventListener('error', fallback);
  video?.addEventListener('playing', () => {
    if (videoFailed) return;
    videoActive = true;
    clearInterval(timer);
    hero?.classList.add('video-active');
    updateCredit();
    if (toggle) toggle.textContent = 'Pause video';
  });
  if (hero) new IntersectionObserver(([entry]) => {
    inView = entry.isIntersecting;
    restart();
  }, { threshold: 0.05 }).observe(hero);
  if (video && !reducedMotion.matches && !connection?.saveData) {
    video.muted = true;
    video.src = video.dataset.src!;
    video.play().catch(fallback);
  }
  if (slides.length) restart();
</script>


