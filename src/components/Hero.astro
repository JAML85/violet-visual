---
const projects = [
  { title: 'Lady Everest', studio: 'Pixelodeon', role: 'Senior Set Modeling & Surfacing Artist', image: '/images/featured/ladyeverest.webp', href: '/professional#project-5', alt: 'Mountain environment from Lady Everest' },
  { title: 'Angry Birds Journey', studio: 'Able&Baker', role: 'Environment / Sets & Props Modeler', image: '/images/featured/angrybirds.webp', href: '/professional#project-3', alt: 'Stylized tropical environment from Angry Birds Journey' },
  { title: 'Audi — A Shorter Letter', studio: 'The Frank Barton Company', role: 'Props Modeler', image: '/images/featured/audi.webp', href: '/professional#project-4', alt: 'Production frame from Audi — A Shorter Letter' },
];
---
<section class="cinema-hero" id="hero" aria-label="Featured productions" aria-roledescription="carousel">
  <h1 class="sr-only">Juan Manchado — Senior Environment / Sets &amp; Props Modeler</h1>
  <div class="cinema-stage">
    {projects.map((project, index) => (
      <article class="cinema-slide" hidden={index !== 0} aria-label={`${index + 1} of ${projects.length}: ${project.title}`} aria-roledescription="slide">
        <img src={project.image} alt={project.alt} width="1920" height="1080" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />
        <div class="cinema-caption">
          <p class="cinema-studio">{project.studio}</p>
          <h2><a href={project.href}>{project.title} <span aria-hidden="true">↗</span></a></h2>
          <p class="cinema-role">{project.role}</p>
        </div>
      </article>
    ))}
    <div class="cinema-controls" hidden>
      <button class="cinema-arrow" data-step="-1" aria-label="Previous featured project">‹</button>
      <div class="cinema-dots">
        {projects.map((project, index) => <button data-slide={index} aria-label={`Show ${project.title}`} aria-pressed={index === 0}><span></span></button>)}
      </div>
      <button class="cinema-arrow" data-step="1" aria-label="Next featured project">›</button>
    </div>
    <p class="sr-only" id="slide-status" aria-live="polite" aria-atomic="true"></p>
  </div>
  <div class="cinema-intro container">
    <p>Environments, sets &amp; props for <strong>film, animation and games.</strong><span>7+ years in production · Madrid, Spain</span></p>
    <a class="text-link" href="#portfolio">Explore my work ↓</a>
  </div>
</section>
<script>
  const hero = document.querySelector<HTMLElement>('.cinema-hero');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('.cinema-slide')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-slide]')];
    const controls = hero.querySelector<HTMLElement>('.cinema-controls');
    const status = hero.querySelector<HTMLElement>('#slide-status');
    let current = 0;
    function show(index: number) {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => { slide.hidden = i !== current; });
      dots.forEach((dot, i) => dot.setAttribute('aria-pressed', String(i === current)));
      if (status) status.textContent = slides[current].getAttribute('aria-label');
    }
    if (controls) controls.hidden = false;
    dots.forEach((dot, index) => dot.addEventListener('click', () => show(index)));
    hero.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(button => {
      button.addEventListener('click', () => show(current + Number(button.dataset.step)));
    });
  }
</script>
<style>
  .cinema-stage { position: relative; background: #080808; }
  .cinema-slide { position: relative; }
  .cinema-slide[hidden], .cinema-controls[hidden] { display: none; }
  .cinema-slide > img { width: 100%; height: min(67vw, 660px); min-height: 420px; object-fit: cover; }
  .cinema-caption { position: absolute; inset: auto 0 0; padding: 90px max(6vw, 24px) 58px; background: linear-gradient(transparent, #000c); text-align: center; }
  .cinema-studio { color: #eee; text-transform: uppercase; letter-spacing: .18em; font-size: 11px; }
  .cinema-caption h2 { font-family: 'Bebas Neue', sans-serif; font-size: clamp(32px, 4vw, 54px); letter-spacing: .05em; line-height: 1.1; margin: 10px 0; }
  .cinema-caption h2 span { font-family: Arial, sans-serif; font-size: 22px; color: var(--gold); }
  .cinema-role { color: #eee; font-size: 12px; letter-spacing: .045em; }
  .cinema-controls { position: absolute; bottom: 4px; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 12px; }
  .cinema-controls button { cursor: pointer; color: #fff; background: transparent; border: 0; width: 44px; height: 44px; }
  .cinema-arrow { font-size: 30px; }
  .cinema-dots { display: flex; }
  .cinema-dots button span { display: block; height: 2px; width: 24px; margin: auto; background: #888; }
  .cinema-dots button[aria-pressed="true"] span { background: var(--gold); }
  .cinema-intro { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 28px; }
  .cinema-intro p { color: var(--muted); font-size: 14px; }
  .cinema-intro strong { color: var(--text); font-weight: 400; }
  .cinema-intro p span { display: block; margin-top: 5px; font-size: 11px; }
  .cinema-intro > a { flex-shrink: 0; }
  @media (max-width: 600px) {
    .cinema-slide > img { height: auto; aspect-ratio: 16 / 9; min-height: 0; object-fit: contain; }
    .cinema-caption { position: static; padding: 24px 20px 58px; background: #111; }
    .cinema-caption h2 { font-size: 32px; }
    .cinema-role { font-size: 11px; }
    .cinema-intro { flex-direction: column; text-align: center; gap: 12px; padding-block: 24px; }
  }
</style>
